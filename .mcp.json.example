{
  "mcpServers": {
    "k8s-sec-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "mcp-server", "k8s-sec-mcp"],
      "cwd": "<REPO_ROOT>",
      "env": {
        "FALCO_SINK_URL": "http://127.0.0.1:8080",
        "FALCO_SINK_TOKEN": "<QUERY_TOKEN_FROM_EVENT_SINK_SECRET>"
      }
    }
  }
}
